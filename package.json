{
  "name": "minehive",
  "version": "1.3.1",
  "description": "Modular, event-driven Mineflayer bot framework",
  "type": "module",
  "private": true,
  "main": "src/index.js",
  "bin": {
    "minehive": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js start",
    "dev": "node --watch src/cli.js start",
    "test": "node --test",
    "test:survival-e2e": "MINEHIVE_E2E_SURVIVAL=1 node --test tests/integration/survival-overnight.test.js",
    "health": "node src/cli.js health",
    "ai": "node src/cli.js ai",
    "ai:setup": "node scripts/setup-local-ai.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "canvas": "^3.2.3",
    "dotenv": "^17.4.2",
    "mineflayer": "^4.33.0",
    "mineflayer-auto-eat": "^5.0.3",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-viewer": "^1.33.0"
  }
}
