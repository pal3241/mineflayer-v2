[Unit]
Description=MineHive autonomous Minecraft fleet
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minehive
Group=minehive
WorkingDirectory=/opt/minehive
EnvironmentFile=/etc/minehive/minehive.env
ExecStart=/usr/bin/node /opt/minehive/src/cli.js start
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/minehive

[Install]
WantedBy=multi-user.target
